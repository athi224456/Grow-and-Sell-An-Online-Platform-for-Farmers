{% extends "base.html" %}{% block content %}
<div class="card"><span class="tag">{{ p.category }}</span><h1>{{ p.name }}</h1>
<div class="price">₹{{ '%.2f'|format(p.price) }} / {{ p.unit }}</div>
<p>{{ p.description or 'No description.' }}</p>
<p class="muted">Farmer: {{ p.farmer }} · {{ p.location or 'N/A' }}{% if g.user %} · 📞 {{ p.phone or 'N/A' }}{% endif %}<br>Stock: {{ p.quantity|round(1) }} {{ p.unit }}</p></div><br>
{% if g.user and g.user.role=='buyer' %}{% if p.quantity>0 %}<h3>Place order</h3>
<form class="stack" method="post" action="{{ url_for('place_order', pid=p.id) }}"><input type="hidden" name="_csrf" value="{{ csrf_token() }}">
<input type="number" name="quantity" step="0.1" min="0.1" max="{{ p.quantity }}" placeholder="Quantity ({{ p.unit }})" required>
<textarea name="address" placeholder="Delivery address" required></textarea><button class="btn">Order</button></form>
{% else %}<p>Out of stock.</p>{% endif %}
{% elif not g.user %}<p><a href="{{ url_for('login') }}">Log in as a buyer</a> to order.</p>{% endif %}{% endblock %}
